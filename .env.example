# مفتاح الوصول لنموذج اللغة عبر CommandCode
COMMANDCODE_API_KEY=

# الموديل المستخدم
# مثال: deepseek/deepseek-v4.1-flash
LLM_MODEL=

# مسار قاعدة البيانات
# مثال: ./database/support.db
DATABASE_PATH=

# مسارات ملفات الموديل المدرّب (يجب أن تطابق ما ينتجه training_notebook.ipynb)
# مثال: ./model/artifacts/model.keras
RNN_MODEL_PATH=
# مثال: ./model/artifacts/tokenizer.pkl
TOKENIZER_PATH=
# مثال: ./model/artifacts/label_encoder.pkl
LABEL_ENCODER_PATH=
# مثال: ./model/artifacts/config.json
MODEL_CONFIG_PATH=

# إعدادات Flask
# مثال: development
FLASK_ENV=
# مثال: 5000
FLASK_PORT=
